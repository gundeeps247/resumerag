# ─────────────────────────────────────────────────────────────────────────────
# ResumeRAG configuration. Copy to .env.local and adjust:  cp .env.example .env.local
# Everything is optional — with no .env file the app uses local Ollama defaults.
# Retrieval, embeddings, reranking and storage never need configuration: they run
# in the browser. These variables only control the server-side LLM proxy.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider /api/llm/chat forwards prompts to:
#   ollama | openai-compatible | huggingface | none
# On Vercel, use "none" (users can still connect their own local Ollama from
# Settings → Language model → "Ollama on this computer") or a hosted provider.
LLM_PROVIDER=ollama

# ── Ollama (default: free, open-source models on your own machine) ───────────
# Install from https://ollama.com, then:  ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Context window. Ollama's small default silently truncates long RAG prompts.
OLLAMA_NUM_CTX=8192

# ── Optional: any OpenAI-compatible server ───────────────────────────────────
# Works with self-hosted vLLM / LM Studio / llama.cpp, or hosted free tiers for
# open-weight models (e.g. Groq, OpenRouter). Keys stay on the server.
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama-3.1-8b-instant

# ── Optional: Hugging Face Inference Providers (free token, small monthly credit)
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Limits & protection for public deployments ───────────────────────────────
LLM_MAX_OUTPUT_TOKENS=1500
# Hosted providers (openai-compatible, huggingface) only serve the model configured above, so
# visitors cannot pick an expensive model on your key. List extra models to offer (comma-separated):
# LLM_ALLOWED_MODELS=
RATE_LIMIT_PER_MINUTE=30
# Shared secret required by the LLM proxy (users enter it in Settings).
# APP_ACCESS_CODE=
